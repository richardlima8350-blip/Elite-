function rodarDiagnostico() {
    const nicho = document.getElementById('nichoInput').value.trim();
    const box = document.getElementById('resultadoIA');

    if (!nicho) {
        alert("Digite o segmento da sua empresa para gerar o plano.");
        return;
    }

    box.style.display = "block";
    box.innerHTML = `<p style="color: #00e5ff;"><strong>Processando arquitetura autônoma para: ${nicho}...</strong></p>`;

    setTimeout(() => {
        box.innerHTML = `
            <h4 style="color: #00e5ff; margin-bottom: 10px;">Arquitetura Recomendada — ${nicho.toUpperCase()}</h4>
            <ul style="padding-left: 20px; color: #94a3b8;">
                <li style="margin-bottom: 8px;"><strong>1. Site de Captação Rápida:</strong> Página otimizada para converter visitantes de anúncios e buscas locais em contatos diretos.</li>
                <li style="margin-bottom: 8px;"><strong>2. Agente Autônomo 24/7:</strong> IA treinada com os serviços e preços de ${nicho} para responder clientes em 3 segundos e agendar reuniões.</li>
                <li><strong>3. Follow-up Automático:</strong> Sistema que retoma contato com leads que pediram orçamento e não finalizaram a compra.</li>
            </ul>
        `;
    }, 500);
}

function atualizarOrcamento() {
    const itens = document.querySelectorAll('.item-calc');
    let soma = 0;

    itens.forEach(item => {
        if (item.checked) {
            soma += Number(item.value);
        }
    });

    document.getElementById('valorTotal').innerText = `R$ ${soma.toLocaleString('pt-BR')}`;
}

function enviarWhatsApp() {
    const total = document.getElementById('valorTotal').innerText;
    const escolhidos = [];

    document.querySelectorAll('.item-calc:checked').forEach(item => {
        escolhidos.push(item.parentElement.innerText.trim());
    });

    if (escolhidos.length === 0) {
        alert("Selecione pelo menos um módulo para continuar.");
        return;
    }

    // Coloque seu número com DDI 55 + DDD + Número
    const telefone = "5500000000000";
    const texto = `Olá! Montei um projeto no site:\n\n*Módulos:* ${escolhidos.join(' | ')}\n*Investimento Estimado:* ${total}\n\nQuero colocar isso para rodar na minha empresa.`;
    
    window.open(`https://wa.me{telefone}?text=${encodeURIComponent(texto)}`, '_blank');
}
